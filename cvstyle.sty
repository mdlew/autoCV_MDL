%% cvstyle.sty -- Curriculum Vitae Style Package
%%
%% DESCRIPTION:
%%   Provides a complete styling framework for academic CVs with support
%%   for publications, teaching, service, mentoring, and funded projects.
%%   Includes bibliography integration, custom sectioning, and PDF/A output.
%%
%% PUBLIC API (stable, documented, safe for user CVs):
%%   \cvcontact   - Contact header with name, address, and links
%%   \cvjob       - Position/appointment entry with optional details
%%   \cvperson    - Mentee/collaborator entry with thesis/position info
%%   \cvproject   - Funded project entry with agency, amount, and role
%%   \teachentry  - Teaching course entry with role and offerings
%%
%% SEMI-PUBLIC API (documented but may evolve):
%%   \activityrow - Generic activity listing (title, org, year)
%%   \iconlink    - Hyperlinked icon with text (for contact info)
%%
%% INTERNAL MACROS (prefixed with cv@, no stability guarantees):
%%   \cv@ifnotempty     - Helper for empty string testing (executes code if not empty)
%%   \cv@ifemptyelse - Helper for empty string testing (with both branches)
%%   \cvpersonRightWidth - Length register for \cvperson layout
%%
%% DEPENDENCIES:
%%   Requires biblatex with 'science' style, fontawesome7, xparse
%%   Custom datamodel: article-pmcid.dbx
%%   Custom biblatex mods: biblatex_science_mods.sty
%%
%% VERSION HISTORY:
%%   v1.2 (2026-01-28): Comprehensive documentation and best practices update
%%   v1.1 (prior):      Initial structured release
%%
%% CODING CONVENTIONS:
%%   - Use \NewDocumentCommand for commands with optional arguments
%%     or complex patterns (provides better error handling via xparse)
%%   - Use \newcommand for simple commands with only mandatory arguments
%%   - Use \newenvironment for paired begin/end constructs
%%   - Prefix internal-only commands/lengths with \cv@ to avoid conflicts
%%   - Use \providecommand for commands that may be defined elsewhere
%%   - Document all public API commands with structured comment blocks

\NeedsTeXFormat{LaTeX2e}[2026-06-01]
\ProvidesPackage{cvstyle}[2026/08/30 v1.3 MDL CV style]

% -------------------------
% Version and compatibility information
% -------------------------
% Requires LaTeX 2026-06-01 or newer and LuaLaTeX. 
% Developed and tested with TeX Live 2026.

% ------------------------- 
% Compilation diagnostics 
% ------------------------- 
% Include package and file versions in the transcript. 
\listfiles 
% Provide more macro-expansion context for errors. 
\errorcontextlines=20 
% Report characters unavailable in the selected font. 
\tracinglostchars=2

% -------------------------
% Packages (grouped & ordered by dependency)
% -------------------------
% BASIC TEXT & LAYOUT (load first)
% URL typesetting and paragraph spacing control
% ---- URL handling ----
% microtype improves spacing, but URL line breaking is handled by xurl/url.
% We also keep URL styling consistent with body text for a cleaner CV look.
\RequirePackage{xurl} % smarter breaks for long URLs
% \RequirePackage{parskip}

% ---- Micro-typography: best-practice defaults for CVs ----
% - High-quality justification with subtle expansion
% - Optical punctuation protrusion
% - Tracking for small caps/headings
% - Safer interword spacing
% - Keep monospace/URLs from expanding (stability)
%
% Note: microtype is fully supported in LuaLaTeX.
\RequirePackage[
  final,
  tracking=true,
  % spacing=true, only works with pdftex 1.40
  % kerning=true, only works with pdftex 1.40
  protrusion=true,
  expansion=true
]{microtype}

% ---- Font selection for protrusion ---- 
% Microtype's default protrusion set, alltext, includes every TU text font, 
% including Font Awesome. Restrict protrusion to the document's default 
% roman and sans-serif families instead. 
% 
% rm* and sf* are translated to \rmdefault and \sfdefault at the end of 
% the preamble. Font Awesome and typewriter families therefore do not match. 
\DeclareMicrotypeSet*[protrusion]{cv-text}{% 
    encoding = TU, family = {rm*, sf*} 
}

% ---- Conservative font expansion ---- 
% Microtype's default expansion set is alltext-nott, which already limits 
% expansion to the default roman and sans-serif families. Consequently: 
% - STIX Two Text receives expansion; 
% - typewriter fonts do not; 
% - Font Awesome free and brands fonts do not. 
% 
% The sloppy* context allows slightly more flexible expansion settings in 
% difficult paragraphs while retaining the global expansion limits. 
\microtypecontext{expansion=sloppy*}
  
% ---- Small-caps tracking ---- 
% The predefined smallcaps tracking set is activated by tracking=true. 
% Customize its tracking amount without redeclaring the set. 
\SetTracking{% 
    encoding = *, shape = sc }{40}

% ---- Paragraph shaping aids that pair well with microtype ----
% These reduce overfulls without airy spacing; adjust conservatively if needed.
\emergencystretch=3em
\pretolerance=2000
\tolerance=3000
\hfuzz=0.2pt

% GRAPHICS & COLOR (load before packages that use color)
\RequirePackage{graphicx}
\RequirePackage[dvipsnames]{xcolor}  % Must use xcolor, not color package
% Reduce margins to 10% on all sides for more content space
\RequirePackage[letterpaper,scale=0.9]{geometry}

% PAGE LAYOUT: Headers, footers, and page numbers
% Use kernel \PreviousTotalPages instead of lastpage package
% \RequirePackage{lastpage}   % For "page X of Y" in footer
\RequirePackage{fancyhdr}   % Custom headers and footers

% -------------------------
% Header/footer behavior
% -------------------------
% Configure section marks to display current section name in footer
% (suppresses automatic uppercasing via \nouppercase in footer below)
% Higher level: Section sets left mark
\renewcommand{\sectionmark}[1]{\markboth{#1}{}}
% Lower level: Subsection sets right mark
\renewcommand{\subsectionmark}[1]{\markright{#1}}

% Reusable footer components 
\newcommand{\cvleftfooter}{% 
    \footnotesize MDL CV -- \nouppercase{\leftmark}% 
} 
\newcommand{\cvrightfooter}{% 
    \footnotesize Page \thepage\ of \PreviousTotalPages %\pageref*{LastPage}% 
} 
% Main page style 
\pagestyle{fancy} 
\fancyhf{} 
\renewcommand{\headrulewidth}{0pt} 
\fancyfoot[L]{\cvleftfooter} 
\fancyfoot[R]{\cvrightfooter} 
% Plain page style 
\fancypagestyle{plain}{% 
    \fancyhf{}% 
    \renewcommand{\headrulewidth}{0pt}% 
    \fancyfoot[L]{\cvleftfooter}% 
    \fancyfoot[R]{\cvrightfooter}% 
}
% First page should have no header or footer
\AtBeginDocument{\thispagestyle{empty}}

% -------------------------
% LAYOUT
% -------------------------
% Standard vertical spacing between CV entries (3.75pt provides tight but readable spacing)
% Note: This is a public configuration parameter that can be adjusted by users
\newlength{\tablerowskip}
\setlength{\tablerowskip}{3.75pt}

% instead of parskip, set spacing manually
\setlength{\parindent}{0pt}
\setlength{\parskip}{\tablerowskip}

% LISTS & ENUMERATIONS
\RequirePackage{enumitem}   % Enhanced list formatting; ensures compatibility with etaremune
\RequirePackage{etaremune}  % Reverse-numbered lists (for publications)


% -------------------------
% SECTION FORMATTING & LAYOUT
% -------------------------
% \RequirePackage{titlesec}   % Custom section/subsection formatting, seems to disrupt latex tagging
\RequirePackage{multicol}   % Multi-column layout support
\RequirePackage{needspace}  % Prevent page breaks between heading and following text
\RequirePackage{ragged2e}   % Provides \RaggedRight (better hyphenation than \raggedright)

% --------------------------------------------------------------- 
% Compact CV title % 
% This calls the existing \maketitle unchanged so that any title 
% tagging supplied by LaTeX remains intact. The negative spaces 
% compensate only for the standard class's title-block layout. 
% --------------------------------------------------------------- 
\newlength{\cvaftertitlecorrection} \setlength{\cvaftertitlecorrection}{-8.3em} \NewDocumentCommand{\cvmaketitle}{}{% 
    \maketitle 
    \vspace*{\cvaftertitlecorrection}% 
}

% Section: Large small-caps with horizontal rule below
% \titleformat{\section}{\Large\scshape\RaggedRight}{}{0em}{}[\titlerule]
% \titlespacing{\section}{0pt}{\tablerowskip}{\tablerowskip}
% % Subsection: Bold, no rule
% \titleformat{\subsection}{\bfseries\RaggedRight}{}{0em}{}
% \titlespacing{\subsection}{0pt}{\tablerowskip}{0pt}

% emulate titlesec formatting changes
% \EditInstance{heading}{section}{ 
%     heading-decls = \Large\scshape\RaggedRight, 
%     before-vspace = \tablerowskip, 
%     after-vspace = \tablerowskip,
%     final-code = { 
%         \par\nobreak 
%         \tagmcbegin{artifact} 
%             \hrule height 0.4pt width \linewidth
%         \tagmcend 
%     }
% } 
% special formatting for sections, cvtagline
\ExplSyntaxOn 
\bool_new:N \l__cv_tagline_bool 
% Set a complete font state in each branch.
\cs_new_protected:Npn \cv_section_title_decls: 
{ 
    \bool_if:NTF \l__cv_tagline_bool 
    { 
        % Tagline: normal size, bold, upright 
        \normalfont \normalsize \bfseries \upshape \RaggedRight    
    } 
    { 
        % Ordinary section: large, medium weight, small caps 
        \normalfont \Large \mdseries \scshape \RaggedRight\Large\scshape\RaggedRight 
    } 
} 
% Add the decorative rule only to ordinary sections.
\cs_new_protected:Npn \cv_section_final_code: 
{ 
    \bool_if:NF \l__cv_tagline_bool 
    { 
        \par
        \nobreak 
        \vspace{\tablerowskip}
        \tagmcbegin{artifact} 
            \hrule height 0.4pt width \linewidth 
        \tagmcend 
        \nobreak 
        \vspace{\tablerowskip}
    } 
} 
% Use the real section command so that semantic heading tagging, 
% bookmarks, marks, and section structure remain intact.
\EditInstance{heading}{section}{ 
    title-decls = \cv_section_title_decls:, 
    before-vspace = \tablerowskip, 
    after-vspace = 0pt, 
    final-code = { \cv_section_final_code: } 
}

\NewDocumentCommand{\cvtagline}{m} 
{ 
    \group_begin: 
        \bool_set_true:N \l__cv_tagline_bool 
        \section*[Mission\ statement]{#1}
    \group_end: 
} 
\ExplSyntaxOff

\EditInstance{heading}{subsection}{ 
    title-decls = { 
        \normalfont 
        \normalsize 
        \bfseries 
        \upshape 
        \RaggedRight 
    }, 
    before-vspace = \tablerowskip, 
    after-vspace = 0pt 
}

% Multicol: Remove spacing
\setlength{\multicolsep}{\tablerowskip}

% -------------------------
% INTERNAL HELPER: Icon + link typesetting
% -------------------------
\NewDocumentCommand{\iconlink}{m m m}{% 
    \href{#2}{% 
        \raisebox{-0.05\height}{#1}\cv@ifnotempty{#3}{~#3}% 
    }% 
}
\NewDocumentCommand{\iconurllink}{m m m}{% 
    \href{#2}{% 
        \raisebox{-0.05\height}{#1}\cv@ifnotempty{#3}{~\nolinkurl{#3}% 
        }% 
    }% 
}

% Keep URL font consistent with surrounding text
\urlstyle{same}

% -------------------------
% BIBLIOGRAPHY CONFIGURATION
% -------------------------
% Use 'science' citation style with custom article-pmcid datamodel
% Configuration: show all authors, article titles, year only, no ISBN/eprint/URL
% Minimum biblatex version 3.16 (2020) recommended for stability
\RequirePackage[style=science, datamodel=article-pmcid, maxnames=99, articletitle=true, date=year, isbn=false, eprint=false, url=false]{biblatex}
% Local modifications to science style (custom .sty file)
\RequirePackage{biblatex_science_mods}

% Vertical spacing between bibliography entries
\setlength\bibitemsep{\tablerowskip}

% -------------------------
% ICONS AND HYPERLINKS
% -------------------------
% WARNING: Package load order matters here!
%   1. fontawesome7 must load before pdfx to ensure proper icon font embedding
%   3. bookmark must load after hyperref (which pdfx provides)
\RequirePackage{fontawesome7}    % Icon fonts)
\RequirePackage{hyperref}
\RequirePackage[open]{bookmark}  % Enhanced PDF bookmarks (requires hyperref)

% Define custom link color and configure hyperref 
% Note: Color names in global namespace; consider using cv@linkcolour for future namespace safety
\definecolor{linkcolour}{rgb}{0,0.2,0.6}  % Dark blue for links
% update for PDF 2.0, include metadata
\hypersetup{ 
  pdftitle={ Matthew Duk-Ying Lew Curriculum Vitae }, 
  pdfauthor={ Matthew Duk-Ying Lew }, 
  pdfsubject={ Curriculum Vitae of Matthew Duk-Ying Lew, Associate Professor, Washington University in St. Louis }, 
  pdfkeywords={ Matthew Lew, curriculum vitae, Washington University in St. Louis, single-molecule orientation microscopy, computational imaging, super-resolution microscopy, biophysics, nanoscience },
  colorlinks=true, 
  urlcolor=linkcolour, 
  linkcolor=linkcolour 
}


% -------------------------
% COMMAND DEFINITION TOOLS
% -------------------------
% xparse provides \NewDocumentCommand for flexible argument handling.
% LaTeX 2026, \NewDocumentCommand and related interfaces are part of the kernel
% Minimum version: 2018-04-06 (xparse syntax stabilized)
% \RequirePackage{xparse}[2018/04/06]

% -------------------------
% INTERNAL UTILITY MACROS
% (Not part of public API; prefixed with cv@ to prevent namespace conflicts)
% -------------------------

% \cv@ifnotempty{<text>}{<not empty code>}
%
% Helper macro to test if argument is empty and execute code if not empty.
% Uses robust \if\relax\detokenize pattern for proper empty testing.
%
% PARAMETERS:
%   #1: Text to test for emptiness
%   #2: Code to execute if #1 is not empty
%
% INTERNAL USE ONLY - reduces code duplication in public commands
\newcommand{\cv@ifnotempty}[2]{%
  \if\relax\detokenize{#1}\relax
    % empty - do nothing
  \else
    #2%
  \fi
}

% \cv@ifemptyelse{<text>}{<empty code>}{<not empty code>}
%
% Helper macro to test if argument is empty and execute appropriate code branch.
% Uses robust \if\relax\detokenize pattern for proper empty testing.
%
% PARAMETERS:
%   #1: Text to test for emptiness
%   #2: Code to execute if #1 is empty
%   #3: Code to execute if #1 is not empty
%
% INTERNAL USE ONLY - reduces code duplication in public commands
\newcommand{\cv@ifemptyelse}[3]{%
  \if\relax\detokenize{#1}\relax
    #2% empty branch
  \else
    #3% not empty branch
  \fi
}

% -------------------------
% PUBLIC API: Activity listing commands
% -------------------------

% \activityrow[<url>]{<title>}{<organization>}{<year>}
\newlength{\activityyearwidth} \setlength{\activityyearwidth}{6.5em} \NewDocumentCommand{\activityrow}{ O{} m m m }{% 
    \par\noindent 
    \parbox[t]{\dimexpr\linewidth-\activityyearwidth\relax}{% 
        \RaggedRight \cv@ifemptyelse{#1} {#2} {\href{#1}{#2}}% 
        \cv@ifnotempty{#3}{, \textit{#3}}% 
    }% 
    \parbox[t]{\activityyearwidth}{% 
        \raggedleft #4% 
    }% 
    \par 
}

% -------------------------
% LIST FORMATTING DEFAULTS
% -------------------------
% Remove default spacing above lists; use consistent \tablerowskip between items
\setlist{
  topsep=0pt, %\tablerowskip,
  itemsep=\tablerowskip, 
  parsep=0pt,
  partopsep=0pt
}

% Remove bullets from first-level itemize (for CV entries that appear as lists)
\renewcommand{\labelitemi}{}
\setlist[itemize,1]{leftmargin=0pt}

% -------------------------
% PUBLIC API: Teaching entry command
% -------------------------

% \teachentry{<course>}{<role>}{<offerings>}
\newlength{\teachdatewidth} 
\setlength{\teachdatewidth}{15em} 
\NewDocumentCommand{\teachentry}{ m m m }{% 
    \par\noindent 
    \parbox[t]{\dimexpr\linewidth-\teachdatewidth\relax}{%
        \RaggedRight \emph{#1}\par 
        Role: #2% 
    }% 
    \parbox[t]{\teachdatewidth}{% 
        \raggedleft #3% 
    }% 
    \par 
    \vspace{\tablerowskip}% 
}

% ========================================================================
% PUBLIC API: Main CV Entry Commands
% ========================================================================
% The following commands form the primary interface for creating CV content.
% All are designed for consistent spacing (\tablerowskip) and support
% optional hyperlinks where appropriate.

% ---------------------------------------------------------------- 
% \cvcontact{<address/contact line>}{<links line>} % 
% The document name/title is now handled separately by 
% \title and \maketitle. 
% ---------------------------------------------------------------- 
\newcommand{\cvcontact}[2]{% 
    \noindent \parbox{\linewidth}{% 
        \RaggedRight #1\par #2\par 
    }% 
    \par 
}
    
% -------------------------
% \cvjob{<title>}{<dates>}[<organization>][<detail>]
% -------------------------
\NewDocumentCommand{\cvjob}{ m m o o }{%
    \par\smallskip 
    \noindent\textbf{#1} \hfill #2\par 
    \IfValueT{#3}{% 
        {\RaggedRight \vspace{-\parskip}%
        #3 \par }   
    }% 
    \IfValueT{#4}{% 
        {\RaggedRight \vspace{-\parskip}%
        #4 \par }
    }% 
}

% \cveducation
\NewDocumentCommand{\cveducation}{m m o m o o}{% 
    \par\smallskip 
    \noindent \textbf{#1} at #2% 
    \IfNoValueF{#3}{\ \normalfont(#3)}% 
    \hfill #4\par 
    \IfValueT{#5}{% 
        {\RaggedRight \vspace{-\parskip} #5 \par}
    } 
    \IfValueT{#6}{% 
        {\RaggedRight \vspace{-\parskip} Advisor: #6 \par}
    } 
    % \vspace{\tablerowskip} 
}

% -------------------------
% \cvperson[<scholar URL>]{<name>}{<affil>}{<year>}[<thesis>][<thesis URL>][<text next to thesis icon>][<position>]
% -------------------------
\newlength{\cvpersonrightwidth} \setlength{\cvpersonrightwidth}{5em}
\NewDocumentCommand{\cvperson}{ o m m m o o o o }{% 
    % Name / affiliation and year 
    \parbox[t]{\dimexpr\linewidth-\cvpersonrightwidth\relax}{% 
        \RaggedRight #2, \textit{#3}% 
        \IfNoValueTF{#1}{}{% 
            \cv@ifnotempty{#1}{% 
            \ \iconlink{\small\faGoogleScholar}{#1}{Scholar}% 
            }% 
        }% 
        \strut
    }% 
    \parbox[t]{\cvpersonrightwidth}{% 
        \raggedleft #4% 
    }% 
    \par 
    % Thesis/dissertation 
    \IfNoValueTF{#5}{}{% 
        \cv@ifnotempty{#5}{% 
            {\vspace{-\parskip} \RaggedRight #5% 
            \IfNoValueTF{#6}{}{% 
                \cv@ifnotempty{#6}{% 
                    \IfNoValueTF{#7} 
                    {\ \iconlink{\small\faFileLines}{#6}{}}% 
                    {\ \iconlink{\small\faFileLines}{#6}{#7}}% 
                    }% 
                }% 
                \par 
            }% 
        }% 
    }% 
    % Thesis link only (no thesis text) 
    \IfNoValueTF{#5}{% 
        \IfNoValueTF{#6}{}{% 
            \cv@ifnotempty{#6}{% 
                \IfNoValueTF{#7} 
                {\iconlink{\small\faFileLines}{#6}{}}% 
                {\iconlink{\small\faFileLines}{#6}{#7}}% 
            }% 
        }% 
    }{}% 
    \par 
    % Position 
    \IfNoValueTF{#8}{}{% 
        \cv@ifnotempty{#8}{% 
            \vspace{-\parskip} #8\par 
        }% 
    }% 
}

% -------------------------
% \cvproject[<proj URL>]{<title>}{<dates>}[<agency URL>]{<agency+grant>}{<amount>}{<role>}
% -------------------------
\newlength{\cvprojectrightwidth} \setlength{\cvprojectrightwidth}{14em} \NewDocumentCommand{\cvproject}{ o m m o m m m }{% 
    \par%\smallskip 
    % Title | Dates 
    \parbox[t]{\dimexpr\linewidth-\cvprojectrightwidth\relax}{% 
        \RaggedRight \IfNoValueTF{#1} 
            {\textit{#2}} 
            {\href{#1}{\textit{#2}}}% 
        \strut
    }% 
    \parbox[t]{\cvprojectrightwidth}{% 
        \raggedleft #3% 
    }% 
    \par 
    % Agency | Amount 
    \vspace{-\parskip} 
    \parbox[t]{\dimexpr\linewidth-\cvprojectrightwidth\relax}{% 
        \RaggedRight \IfNoValueTF{#4} 
            {#5} 
            {\href{#4}{#5}}% 
        \strut
    }% 
    \parbox[t]{\cvprojectrightwidth}{% 
        \raggedleft #6% 
    }% 
    \par 
    % Role 
    \vspace{-\parskip} 
    {\RaggedRight Role: #7\par }% 
}


